# Configuración de la API de la clínica veterinaria.
#
# Copia este archivo a `.env` en la raíz del repositorio para ajustar los
# valores de un entorno concreto. Docker Compose usa `.env` para resolver las
# variables de la orquestación; la aplicación lo lee con `pydantic-settings`.

# Conexión de la aplicación a PostgreSQL (servicio `db` de la orquestación).
DATABASE_URL=postgresql+psycopg://vetclinic:vetclinic@localhost:5432/vetclinic

# Credenciales del servicio PostgreSQL que levanta la orquestación.
POSTGRES_USER=vetclinic
POSTGRES_PASSWORD=vetclinic
POSTGRES_DB=vetclinic

# Secreto de firma de los tokens JWT: genera uno propio para cada entorno.
JWT_SECRET=cambia-este-secreto-por-uno-seguro

# Algoritmo de firma y duración en minutos de los tokens.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Base de datos aislada que usa la suite de pruebas.
TEST_DATABASE_URL=postgresql+psycopg://vetclinic:vetclinic@localhost:5432/vetclinic_test

# Puerto de escucha de la API: lo usa el contenedor y el puerto publicado.
PORT=8000
