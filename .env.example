# Conexión a PostgreSQL.
# Con docker compose el host es el servicio "db"; en local, "localhost".
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5432/clinic

# Clave de firma de los tokens JWT. Es obligatoria: sin ella la aplicación
# no arranca. Genera una con "openssl rand -hex 32".
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-y-segura

# Vigencia del token de acceso, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60
